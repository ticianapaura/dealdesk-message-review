{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/process", "destination": "/index.html" },
    { "source": "/prototype", "destination": "/index.html" },
    { "source": "/prototype/:path*", "destination": "/index.html" }
  ]
}
